<mxfile host="synthtree"><diagram id="arch" name="architecture"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="1. SynthTree generator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=1;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="260" height="430" as="geometry"/></mxCell><mxCell id="n3" value="2. Paired sequences and ground truth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=1;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="260" height="430" as="geometry"/></mxCell><mxCell id="n4" value="3. Reconstruction (3DGS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=1;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="20" width="260" height="430" as="geometry"/></mxCell><mxCell id="n5" value="4. Evaluation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=1;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="950" y="20" width="260" height="430" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Procedural sapling&lt;/b&gt;&lt;br&gt;10 species presets, leaves as&lt;br&gt;real geometry with leaf IDs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="35" y="80" width="230" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Closed-form wind&lt;/b&gt;&lt;br&gt;branch sway + rigid leaf flutter&lt;br&gt;calm / 1.5 / 3 / 5 m/s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="35" y="168" width="230" height="70" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Blender rendering&lt;/b&gt;&lt;br&gt;D435i-like RGB-D, hand-held orbit&lt;br&gt;EEVEE beauty + Cycles data pass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="35" y="256" width="230" height="70" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Sensor noise model&lt;/b&gt;&lt;br&gt;RGB and depth noise,&lt;br&gt;flying pixels at leaf edges" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="35" y="344" width="230" height="70" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Paired calm / windy sequences&lt;/b&gt;&lt;br&gt;same tree, same camera path,&lt;br&gt;only the wind differs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="345" y="80" width="230" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Exact per-leaf ground truth&lt;/b&gt;&lt;br&gt;leaf transforms at every frame,&lt;br&gt;leaf IDs, depth, flow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="345" y="168" width="230" height="70" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Temporal sampling&lt;/b&gt;&lt;br&gt;30 fps (all frames)&lt;br&gt;7.5 fps (every 4th frame)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="345" y="256" width="230" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Second camera&lt;/b&gt;&lt;br&gt;same orbit, 90° ahead,&lt;br&gt;synchronised frame by frame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="345" y="344" width="230" height="70" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Static 3DGS&lt;/b&gt;&lt;br&gt;no motion model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="655" y="80" width="230" height="70" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Deformable 3DGS&lt;/b&gt;&lt;br&gt;MLP(position, time) offsets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="655" y="168" width="230" height="70" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Per-cell rigid motion&lt;/b&gt;&lt;br&gt;k-means cells, SE(3) trajectory per&lt;br&gt;cell as a Fourier series in time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="655" y="256" width="230" height="70" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Oracle grouping&lt;/b&gt; (upper bound)&lt;br&gt;one motion cell per true leaf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;dashed=1;" vertex="1" parent="1"><mxGeometry x="655" y="344" width="230" height="70" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Posed ground truth&lt;/b&gt;&lt;br&gt;leaf surface posed at each&lt;br&gt;held-out frame time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="965" y="80" width="230" height="70" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Geometry metrics&lt;/b&gt;&lt;br&gt;leaf F-score at 5 mm, Chamfer,&lt;br&gt;per-leaf centroid error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="965" y="168" width="230" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Image metric&lt;/b&gt;&lt;br&gt;PSNR on held-out views" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="965" y="256" width="230" height="70" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Wind component&lt;/b&gt;&lt;br&gt;windy minus calm error,&lt;br&gt;per method and tree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="965" y="344" width="230" height="70" as="geometry"/></mxCell><mxCell id="e22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;fontFamily=Helvetica;fontColor=#222222;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1