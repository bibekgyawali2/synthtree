<mxfile host="synthtree"><diagram id="model" name="model architecture"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Sensor depth&lt;/b&gt;&lt;br&gt;back-projected points&lt;br&gt;(initialisation)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="170" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Camera pose&lt;/b&gt; at &lt;i&gt;t&lt;/i&gt;&lt;br&gt;(known exactly, no SLAM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="170" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Canonical Gaussians&lt;/b&gt;&lt;br&gt;position, rotation, scale,&lt;br&gt;opacity, colour&lt;br&gt;(time-average pose)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="200" height="90" as="geometry"/></mxCell><mxCell id="n5" value="Densify / prune&lt;br&gt;(gsplat default strategy)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="175" width="200" height="50" as="geometry"/></mxCell><mxCell id="n6" value="Motion module (differs per method)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=1;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="490" y="20" width="330" height="470" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Static 3DGS&lt;/b&gt;&lt;br&gt;no motion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Deformable 3DGS&lt;/b&gt;&lt;br&gt;MLP(γ(position), γ(&lt;i&gt;t&lt;/i&gt;))&lt;br&gt;→ offsets of position, rotation, scale" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="505" y="125" width="300" height="70" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Per-cell rigid motion&lt;/b&gt;&lt;br&gt;k-means cells: 2,048 leaf-scale, 32 branch-scale&lt;br&gt;each cell: SE(3) trajectory = Fourier series&lt;br&gt;in &lt;i&gt;t&lt;/i&gt; up to 10 Hz, unlocked coarse to fine&lt;br&gt;&lt;i&gt;x&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;) = T&lt;sub&gt;branch&lt;/sub&gt;(&lt;i&gt;t&lt;/i&gt;) · T&lt;sub&gt;cell&lt;/sub&gt;(&lt;i&gt;t&lt;/i&gt;) · &lt;i&gt;x&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="505" y="210" width="300" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Oracle groups&lt;/b&gt;: one cell per true leaf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;dashed=1;" vertex="1" parent="1"><mxGeometry x="505" y="335" width="300" height="45" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;True-motion oracle&lt;/b&gt;: leaf cells follow&lt;br&gt;the exact leaf motion (nothing learned)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;dashed=1;" vertex="1" parent="1"><mxGeometry x="505" y="395" width="300" height="60" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Evaluation&lt;/b&gt; at held-out times&lt;br&gt;centres + footprint samples&lt;br&gt;vs leaf surface posed at &lt;i&gt;t&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="860" y="60" width="190" height="80" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Gaussians at time &lt;i&gt;t&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="870" y="205" width="170" height="50" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Differentiable rasteriser&lt;/b&gt;&lt;br&gt;(gsplat)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="870" y="300" width="170" height="60" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Rendered image&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="870" y="410" width="170" height="45" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Loss&lt;/b&gt;&lt;br&gt;0.8 L1 + 0.2 D-SSIM&lt;br&gt;+ acceleration and amplitude&lt;br&gt;penalties (per-cell motion)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Training view&lt;/b&gt;&lt;br&gt;RGB image at time &lt;i&gt;t&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#444444;strokeWidth=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="200" height="60" as="geometry"/></mxCell><mxCell id="e18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontFamily=Helvetica;fontColor=#222222;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontFamily=Helvetica;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontFamily=Helvetica;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontFamily=Helvetica;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontFami